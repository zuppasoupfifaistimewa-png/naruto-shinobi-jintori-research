#!/usr/bin/env python3
from __future__ import annotations
import argparse,csv,fnmatch,io,subprocess
from collections import defaultdict
from pathlib import Path

LIMIT=64
PROTECTED={0x800F5F54,0x800B54DC,0x800F5EBC}
PREFIXES=("ja-run-","ka-run-","la-run-","ma-run-","na-run-","oa-run-","pa-run-","qa-run-")

def spans(rows):
    by=defaultdict(list)
    for z in rows: by[z["image"]].append((z["pc"],z["end"]))
    out=[]
    for im,items in by.items():
        cur=None
        for x,y in sorted(items):
            if cur is None or x>cur[1]:
                if cur: out.append((im,cur[0],cur[1]))
                cur=[x,y]
            else: cur[1]=max(cur[1],y)
        if cur: out.append((im,cur[0],cur[1]))
    return sorted(out)

def selftest():
    fixture="image\tpc\tbytes\nENTRY1\t0x1000\t"+" ".join(["00"]*65)+"\n"
    rows=list(csv.DictReader(io.StringIO(fixture),delimiter="\t"))
    assert len(rows)==1 and len(bytes.fromhex(rows[0]["bytes"]))==65
    assert any(y-x>64 for _,x,y in spans([{"image":"ENTRY1","pc":0x1000,"end":0x1041}]))
    assert not any(y-x>64 for _,x,y in spans([{"image":"ENTRY1","pc":0x1000,"end":0x1040}]))
    assert "\t" in fixture and "\\t" not in fixture
    return "FIXTURE_65_BYTES=DETECTED\nFIXTURE_64_BYTES=PASS\nTSV_DELIMITER=ONE_LITERAL_TAB\nLITERAL_BACKSLASH_T_ABSENT=PASS\n"

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--root",required=True,type=Path);ap.add_argument("--out",required=True,type=Path)
    ap.add_argument("--baseline",default="88c7c185b638a2fdd22e3212055fe50cb88b4d81")
    a=ap.parse_args();root=a.root.resolve();out=a.out.resolve();out.mkdir(parents=True,exist_ok=True)
    (out/"QA0_HARNESS_SELFTEST.txt").write_text(selftest(),encoding="utf-8",newline="")
    tracked=subprocess.check_output(["git","-C",str(root),"ls-files","-z"]).decode().split("\0")
    paths=[root/x for x in tracked if x.endswith((".py",".pytxt")) and (root/x).is_file()]
    for p in sorted((root/"tools"/"qa").glob("*.pytxt")):
        if p not in paths: paths.append(p)
    compiled=[]
    for p in paths:
        try: compile(p.read_text(encoding="utf-8"),str(p),"exec");compiled.append((p.relative_to(root).as_posix(),"PASS",""))
        except Exception as e: compiled.append((p.relative_to(root).as_posix(),"FAIL",type(e).__name__+":"+str(e)))
    with (out/"QA0_PYCOMPILE.tsv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f,delimiter="\t",lineterminator="\n");w.writerow(["path","status","reason"]);w.writerows(compiled)
    if not compiled or any(x[1]!="PASS" for x in compiled): raise SystemExit("PY_COMPILE_FAIL")

    stage=root/"reports"/"stage1_economy"; rows=[]; files=[]
    for p in sorted(stage.rglob("*.tsv")):
        rel=p.relative_to(root).as_posix()
        if not any(part.startswith(PREFIXES) for part in p.relative_to(stage).parts): continue
        # Generated QA0 ledgers/rebuilt views are outputs, never raw quote inputs.
        if p.name.startswith("QA0_"): continue
        files.append(p)
        with p.open(encoding="utf-8",newline="") as f:
            rd=csv.DictReader(f,delimiter="\t")
            if not rd.fieldnames or not {"image","pc","bytes"}.issubset(set(rd.fieldnames)): continue
            for z in rd:
                raw=z.get("bytes","").strip(); im=z.get("image","").strip()
                if not raw or raw=="TIDAK TAHU" or not im: continue
                try: pc=int(z["pc"],16); b=bytes(int(x,16) for x in raw.split())
                except Exception: continue
                if not b or len(b)%4: continue
                rows.append({"image":im,"pc":pc,"end":pc+len(b),"raw":b,"source":rel,"line":rd.line_num,"excerpt":z.get("excerpt_id","")})
    by={}
    conflict=set()
    for z in rows:
        k=(z["image"],z["pc"]);old=by.get(k)
        if old is None:by[k]=z["raw"]
        elif old!=z["raw"]:
            if old.startswith(z["raw"]):continue
            if z["raw"].startswith(old):by[k]=z["raw"]
            else:conflict.add(k)
    normalized=[{"image":im,"pc":pc,"end":pc+len(b),"raw":b} for (im,pc),b in by.items() if (im,pc) not in conflict]
    full_spans=spans(normalized); full_bad=[x for x in full_spans if x[2]-x[1]>LIMIT]

    # Create a replacement view by pruning only PA/QA rows in the new output.
    deleted=set()
    for im,start,end in full_bad:
        while True:
            current=[z for z in normalized if (z["image"],z["pc"]) not in deleted]
            before=max((y-x for ii,x,y in spans([z for z in current if z["image"]==im]) if ii==im and x<end and y>start),default=0)
            if before<=LIMIT:break
            keys=sorted({(z["image"],z["pc"]) for z in rows if z["image"]==im and z["pc"]<end and z["end"]>start
              and ("/pa-run-" in z["source"] or "/qa-run-" in z["source"]) and z["pc"] not in PROTECTED})
            chosen=None
            for key in keys:
                occ=[z for z in rows if (z["image"],z["pc"])==key]
                if not occ or any(not ("/pa-run-" in z["source"] or "/qa-run-" in z["source"]) for z in occ):continue
                trial=deleted|{key}; candidate=[z for z in normalized if (z["image"],z["pc"]) not in trial]
                after=max((y-x for ii,x,y in spans([z for z in candidate if z["image"]==im]) if ii==im and x<end and y>start),default=0)
                if after<before:chosen=key;break
            if chosen is None:break
            deleted.add(chosen)

    rebuilt=[z for z in normalized if (z["image"],z["pc"]) not in deleted]
    rebuilt_spans=spans(rebuilt); rebuilt_bad=[x for x in rebuilt_spans if x[2]-x[1]>LIMIT]
    deleted_rows=[z for z in rows if (z["image"],z["pc"]) in deleted and ("/pa-run-" in z["source"] or "/qa-run-" in z["source"])]
    with (out/"QA0_DELETED_ROWS.tsv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f,delimiter="\t",lineterminator="\n");w.writerow(["source_file","source_line","image","pc","bytes","excerpt_id"])
        for z in sorted(deleted_rows,key=lambda x:(x["source"],x["line"])):
            w.writerow([z["source"],z["line"],z["image"],f'0x{z["pc"]:08X}',z["raw"].hex(" ").upper(),z["excerpt"]])
    with (out/"QA0_REBUILT_PA_QA_EXCERPTS.tsv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f,delimiter="\t",lineterminator="\n");w.writerow(["image","pc","bytes","source_file","source_line","excerpt_id"])
        for z in sorted((x for x in rows if "/pa-run-" in x["source"] or "/qa-run-" in x["source"]),key=lambda x:(x["image"],x["pc"],x["source"],x["line"])):
            if (z["image"],z["pc"]) in deleted:continue
            w.writerow([z["image"],f'0x{z["pc"]:08X}',z["raw"].hex(" ").upper(),z["source"],z["line"],z["excerpt"]])
    def save_spans(name,data):
        with (out/name).open("w",encoding="utf-8",newline="") as f:
            w=csv.writer(f,delimiter="\t",lineterminator="\n");w.writerow(["image","start_pc","end_pc_exclusive","contiguous_bytes"])
            for im,x,y in data:w.writerow([im,f"0x{x:08X}",f"0x{y:08X}",y-x])
    save_spans("QA0_FULL_ARCHIVE_SPANS.tsv",full_spans);save_spans("QA0_PA_QA_REPLACEMENT_SPANS.tsv",rebuilt_spans)
    with (out/"QA0_OVERLIMIT_ORIGINS.tsv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f,delimiter="\t",lineterminator="\n");w.writerow(["image","group_start_pc","group_end_pc_exclusive","group_bytes","source_file","source_line","row_pc","row_bytes"])
        for im,x,y in full_bad:
            for z in rows:
                if z["image"]==im and z["pc"]<y and z["end"]>x:w.writerow([im,f"0x{x:08X}",f"0x{y:08X}",y-x,z["source"],z["line"],f'0x{z["pc"]:08X}',len(z["raw"])])
    # Correct erroneous PA3 control-transfer labels in a companion TSV only.
    pa3_label_rows=[]
    for p in sorted(stage.rglob("PA3_B24C8_REACHABILITY.tsv")):
        rel=p.relative_to(root).as_posix()
        if not any(part.startswith(("pa-run-","qa-run-")) for part in p.relative_to(stage).parts):
            continue
        with p.open("r",encoding="utf-8",newline="") as f:
            rd=csv.DictReader(f,delimiter="\t")
            for z in rd:
                candidate=(z.get("control_transfer_candidate") or "").strip()
                if not candidate.lower().startswith("lw "):
                    continue
                candidate_pc=(z.get("control_transfer_candidate_pc") or "").strip()
                pred=(z.get("predecessor_pc") or "").strip()
                target=(z.get("target_pc") or "").strip()
                if candidate_pc=="0x800B24C0" and pred=="0x800B24C4" and target=="0x800B24C8":
                    corrected_pc="NONE"
                    corrected="FALLTHROUGH"
                    reason="0x800B24C0 is lw, not control transfer; 0x800B24C4 nop falls through to target 0x800B24C8"
                else:
                    corrected_pc="TIDAK TAHU"
                    corrected="TIDAK TAHU"
                    reason="candidate instruction is lw; independent control-flow review required"
                pa3_label_rows.append([rel,rd.line_num,candidate_pc,candidate,pred,z.get("predecessor_instruction",""),
                                       target,corrected_pc,corrected,reason])
    with (out/"QA0_PA3_CONTROL_TRANSFER_LABEL_AUDIT.tsv").open("w",encoding="utf-8",newline="") as f:
        w=csv.writer(f,delimiter="\t",lineterminator="\n")
        w.writerow(["source_file","source_line","original_candidate_pc","original_candidate","predecessor_pc",
                    "predecessor_instruction","target_pc","corrected_candidate_pc","corrected_candidate","correction_reason"])
        w.writerows(pa3_label_rows)
    wfdir=root/".github"/"workflows"; wfpaths=[]
    for p in sorted(wfdir.glob("*.yml")):
        ls=p.read_text(encoding="utf-8",errors="replace").splitlines()
        for i,line in enumerate(ls):
            if line.strip()=="paths:":
                ind=len(line)-len(line.lstrip());j=i+1
                while j<len(ls):
                    if ls[j].strip() and len(ls[j])-len(ls[j].lstrip())<=ind:break
                    v=ls[j].strip()
                    if v.startswith("-"):wfpaths.append((p.name,v[1:].strip().strip('"').strip("'")))
                    j+=1
    targets=[".github/workflows/qa0-qa5.yml","tools/qa/RunQA0Harness.pytxt","tools/qa/RunQA4Control.pytxt"]
    collisions=[(wf,pat,t) for wf,pat in wfpaths if wf!="qa0-qa5.yml" for t in targets if fnmatch.fnmatchcase(t,pat)]
    with (out/"QA0_WORKFLOW_PATHS_AUDIT.txt").open("w",encoding="utf-8",newline="") as f:
        f.write(f"WORKFLOW_FILES={len(list(wfdir.glob('*.yml')))}\nPATH_FILTER_ENTRIES={len(wfpaths)}\nCOLLISIONS={len(collisions)}\n")
        f.write("COLLISION_DETAILS="+(";".join(f"{x[0]}:{x[1]}->{x[2]}" for x in collisions) or "none")+"\n")
    lines=[
      "BASELINE_INCLUSIVE="+a.baseline,f"TSV_SOURCE_FILES={len(files)}",f"QUOTE_ROWS={len(rows)}",f"UNIQUE_IMAGE_PC={len(normalized)}",
      f"BYTE_CONFLICTS={len(conflict)}",f"FULL_ARCHIVE_MAX_CONTIGUOUS={max((y-x for _,x,y in full_spans),default=0)}",
      f"FULL_ARCHIVE_OVER_LIMIT_GROUPS={len(full_bad)}",f"PA_QA_DELETED_PHYSICAL_ROWS={len(deleted_rows)}",
      f"PA_QA_REPLACEMENT_MAX_CONTIGUOUS={max((y-x for _,x,y in rebuilt_spans),default=0)}",
      f"PA_QA_REPLACEMENT_OVER_LIMIT_GROUPS={len(rebuilt_bad)}",f"PROTECTED_CALLSITE_ROWS_REMOVED={sum(z['pc'] in PROTECTED for z in deleted_rows)}",
      f"SELFTEST=PASS",f"PY_COMPILE={sum(x[1]=='PASS' for x in compiled)}/{len(compiled)}",
      f"WORKFLOW_FILES={len(list(wfdir.glob('*.yml')))}",f"PATH_FILTER_ENTRIES={len(wfpaths)}",f"PATH_FILTER_COLLISIONS={len(collisions)}",
      "STATUS="+("PASS" if not full_bad and not conflict and not collisions else "SEBAGIAN"),
      "LEGACY_FILES_MODIFIED=no","STATUS_MD_MODIFIED=no","RELEASES_MODIFIED=no","LIMIT_BYTES=64"
    ]
    (out/"QA0_EXCERPT_AUDIT.txt").write_text("\n".join(lines)+"\n",encoding="utf-8",newline="")
    print("\n".join(lines))
    if full_bad or conflict or collisions:raise SystemExit(1)

if __name__=="__main__":main()
