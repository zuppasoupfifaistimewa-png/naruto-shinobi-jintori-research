#!/usr/bin/env python3
# TA0 final-head verification for baseline aa32fbce; audit thresholds unchanged.
# Final-head trigger marker: recheck the prior HA2 deletion with a tab-safe parser.
from __future__ import annotations

import argparse
import ast
import json
import sys
import csv
import fnmatch
import io
import re
import subprocess
from collections import defaultdict
from pathlib import Path

LIMIT = 64
BASELINE_DEFAULT = "aa32fbcee97c8f49946a8e589010cfb9ef1a6928"
TARGET_DIRS = (
    "ka-run-42558598094",
    "ma-run-42558598089",
    "na-run-42558598171",
)
HA2_PC = 0x800F5D8C
HA2_END = 0x800F5DD0


def git(root: Path, *args: str) -> str:
    return subprocess.check_output(["git", "-C", str(root), *args], text=True)


def normalize_header(value: str) -> str:
    return (value or "").strip().lower()


def normalize_image(value: str) -> str:
    raw = (value or "").strip().upper()
    compact = re.sub(r"[^A-Z0-9]", "", raw)
    if "ENTRY1" in compact:
        return "ENTRY1"
    if compact in {"EXE", "SLPS03553", "SLPS03553EXE"} or "SLPS03553" in compact:
        return "EXE"
    return re.sub(r"[^A-Z0-9]+", "_", raw).strip("_") or "TIDAK_TAHU"


def parse_pc(value: str) -> int:
    return int((value or "").strip(), 16)


def parse_bytes(value: str) -> bytes:
    tokens = (value or "").strip().split()
    if not tokens or any(len(token) != 2 for token in tokens):
        raise ValueError("bytes must be whitespace-separated two-digit hex")
    return bytes(int(token, 16) for token in tokens)


def count_rows(text: str) -> int:
    rows = list(csv.reader(io.StringIO(text), delimiter="\t"))
    return max(0, len(rows) - 1)


def read_evidence(stage: Path):
    rows = []
    candidate_files = []
    malformed = []
    labels = set()
    total_tsv = 0
    for path in sorted(stage.rglob("*.tsv")):
        total_tsv += 1
        rel = path.relative_to(stage.parent.parent).as_posix()
        try:
            with path.open("r", encoding="utf-8-sig", newline="") as handle:
                reader = csv.DictReader(handle, delimiter="\t")
                if not reader.fieldnames:
                    continue
                header_map = {normalize_header(name): name for name in reader.fieldnames}
                if not {"image", "pc", "bytes"}.issubset(header_map):
                    continue
                candidate_files.append(rel)
                for row in reader:
                    raw_bytes = (row.get(header_map["bytes"]) or "").strip()
                    raw_image = (row.get(header_map["image"]) or "").strip()
                    raw_pc = (row.get(header_map["pc"]) or "").strip()
                    if not raw_bytes or raw_bytes.upper() in {
                        "TIDAK TAHU", "UNKNOWN", "N/A", "NONE", "-"
                    }:
                        continue
                    try:
                        image = normalize_image(raw_image)
                        pc = parse_pc(raw_pc)
                        payload = parse_bytes(raw_bytes)
                        if image == "TIDAK_TAHU" or not (0 <= pc <= 0xFFFFFFFF):
                            raise ValueError("invalid image label or PC")
                    except Exception as exc:
                        malformed.append([
                            rel, reader.line_num, raw_image, raw_pc, raw_bytes,
                            type(exc).__name__ + ":" + str(exc),
                        ])
                        continue
                    labels.add(image)
                    rows.append({
                        "image": image,
                        "pc": pc,
                        "end": pc + len(payload),
                        "raw": payload,
                        "source": rel,
                        "line": reader.line_num,
                    })
        except Exception as exc:
            malformed.append([
                rel, 0, "", "", "", "FILE_READ_" + type(exc).__name__ + ":" + str(exc)
            ])
    return rows, total_tsv, candidate_files, malformed, sorted(labels)


def byte_union(rows):
    values = {}
    origins = defaultdict(list)
    conflicts = set()
    for row in rows:
        image, pc, raw = row["image"], row["pc"], row["raw"]
        for offset, value in enumerate(raw):
            key = (image, pc + offset)
            origins[key].append((row["source"], row["line"], pc, len(raw)))
            if key in values and values[key] != value:
                conflicts.add(key)
            else:
                values[key] = value

    by_image = defaultdict(list)
    for image, address in values:
        by_image[image].append(address)
    spans = []
    for image, addresses in by_image.items():
        addresses.sort()
        if not addresses:
            continue
        start = previous = addresses[0]
        for address in addresses[1:]:
            if address != previous + 1:
                spans.append((image, start, previous + 1))
                start = address
            previous = address
        spans.append((image, start, previous + 1))
    return values, origins, conflicts, sorted(spans)


def write_tsv(path: Path, header, rows):
    with path.open("w", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
        writer.writerow(header)
        writer.writerows(rows)


def maybe_prune_ha2(stage: Path, root: Path, baseline: str, spans):
    over_target = [
        (image, start, end)
        for image, start, end in spans
        if image == "ENTRY1" and end - start > LIMIT
        and start <= HA2_PC < end and start < HA2_END
    ]
    if not over_target:
        return [], True, False

    targets = sorted(stage.glob("ha2-ha3-static-run-*/attempt-1/HA2_GLOBAL_OPERAND_ACCESS.tsv"))
    if not targets:
        return [["TIDAK_TAHU", 0, 0, 0, "TIDAK_TAHU", "TIDAK_TAHU",
                 "ENTRY1", "?", "FAIL_NO_HA2_SOURCE_FILES"]], False, True

    audit = []
    ok = True
    for path in targets:
        rel = path.relative_to(root).as_posix()
        baseline_text = git(root, "show", f"{baseline}:{rel}")
        baseline_lines = baseline_text.splitlines(keepends=True)
        current_text = path.read_text(encoding="utf-8")
        base_header = next(csv.reader(io.StringIO(baseline_text), delimiter="\t"), [])
        header_map = {normalize_header(name): index for index, name in enumerate(base_header)}
        if not {"pc", "bytes"}.issubset(header_map):
            audit.append([rel, count_rows(baseline_text), count_rows(current_text), 0,
                          "TIDAK_TAHU", "TIDAK_TAHU", "ENTRY1", "M", "FAIL_HEADER"])
            ok = False
            continue

        matches = []
        match_cells = None
        for line_index, line in enumerate(baseline_lines):
            if line_index == 0:
                continue
            cells = next(csv.reader([line], delimiter="\t"), [])
            if len(cells) <= max(header_map["pc"], header_map["bytes"]):
                continue
            try:
                pc = parse_pc(cells[header_map["pc"]])
                payload = parse_bytes(cells[header_map["bytes"]])
            except Exception:
                continue
            if pc == HA2_PC and len(payload) == 4:
                matches.append(line_index)
                match_cells = cells

        if len(matches) != 1:
            audit.append([rel, count_rows(baseline_text), count_rows(current_text), 0,
                          "TIDAK_TAHU", "TIDAK_TAHU", "ENTRY1", "M", "FAIL_BASELINE_MATCH_COUNT"])
            ok = False
            continue

        expected_lines = baseline_lines.copy()
        del expected_lines[matches[0]]
        expected_text = "".join(expected_lines)
        if current_text == baseline_text:
            # Defensive fallback: apply only the explicitly authorized one-row deletion.
            current_lines = current_text.splitlines(keepends=True)
            del current_lines[matches[0]]
            current_text = "".join(current_lines)
            path.write_text(current_text, encoding="utf-8", newline="")

        git_diff = git(root, "diff", "--no-renames", "--name-status", baseline, "--", rel).splitlines()
        git_status = git_diff[0].split("\t", 1)[0] if git_diff else "?"
        deleted_rows = count_rows(baseline_text) - count_rows(current_text)
        exact = current_text == expected_text and deleted_rows == 1 and git_status == "M"
        verification = "PASS" if exact else "FAIL_NOT_EXACTLY_BASELINE_MINUS_ONE_ROW"
        pc_text = match_cells[header_map["pc"]]
        bytes_text = match_cells[header_map["bytes"]]
        image_text = (match_cells[header_map["image"]]
                      if "image" in header_map and len(match_cells) > header_map["image"]
                      else "ENTRY1")
        audit.append([rel, count_rows(baseline_text), count_rows(current_text), deleted_rows,
                      pc_text, bytes_text, normalize_image(image_text), git_status, verification])
        ok = ok and exact

    return audit, ok, True

def audit_target_deletions(root: Path, baseline: str):
    rows = []
    statuses = {}
    for dirname in TARGET_DIRS:
        prefix = f"reports/stage1_economy/{dirname}/"
        before = git(root, "ls-tree", "-r", "--name-only", baseline, "--", prefix).splitlines()
        head = git(root, "ls-tree", "-r", "--name-only", "HEAD", "--", prefix).splitlines()
        diff = git(root, "diff", "--no-renames", "--name-status", baseline, "HEAD", "--", prefix)
        changed = {}
        for line in diff.splitlines():
            parts = line.split("\t", 1)
            if len(parts) == 2:
                changed[parts[1]] = parts[0]
        exact = bool(before) and not head and len(changed) == len(before) and all(
            changed.get(path) == "D" for path in before
        )
        rows.append([dirname, len(before), sum(1 for x in changed.values() if x == "D"),
                     len(head), "PASS" if exact else "FAIL"])
        statuses[dirname] = exact
    return rows, statuses


def workflow_path_audit(root: Path):
    workflow_dir = root / ".github" / "workflows"
    workflows = sorted(workflow_dir.glob("*.yml"))
    patterns = []
    catchalls = []
    legacy_refs = []
    for path in workflows:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        if any(re.search(r"RunSA1Windows\.py(?:['\"\s]|$)", line) for line in lines):
            legacy_refs.append(path.name)
        for index, line in enumerate(lines):
            if line.strip() != "paths:":
                continue
            indent = len(line) - len(line.lstrip())
            cursor = index + 1
            while cursor < len(lines):
                candidate = lines[cursor]
                if candidate.strip() and len(candidate) - len(candidate.lstrip()) <= indent:
                    break
                item = candidate.strip()
                if item.startswith("-"):
                    pattern = item[1:].strip().strip('"').strip("'")
                    patterns.append((path.name, pattern))
                    if pattern == "**/*.py":
                        catchalls.append(path.name)
                cursor += 1

    last_commit_files = git(root, "diff", "--name-only", "HEAD^", "HEAD").splitlines()
    trigger_matches = sorted({
        workflow for workflow, pattern in patterns
        for changed_path in last_commit_files
        if fnmatch.fnmatchcase(changed_path, pattern)
    })
    previous_subject = git(root, "log", "-1", "--format=%s", "HEAD^").strip()
    return {
        "workflow_count": len(workflows),
        "path_pattern_count": len(patterns),
        "catchalls": sorted(set(catchalls)),
        "legacy_refs": sorted(set(legacy_refs)),
        "last_commit_files": last_commit_files,
        "trigger_matches": trigger_matches,
        "prep_commit_skip_ci": "[skip ci]" in previous_subject.lower(),
    }


def sa1_audit(root: Path):
    source = root / "tools" / "stage1" / "RunSA1Windows.pytxt"
    old_source = root / "tools" / "stage1" / "RunSA1Windows.py"
    source_text = source.read_text(encoding="utf-8")
    checks = {
        "OLD_PY_REMOVED": not old_source.exists(),
        "CALLER_WINDOW_64B": 'window_rows("EXE"' in source_text and "WINDOW_BYTES = 64" in source_text,
        "PROLOG_WINDOW_8B": 'prolog_pc, "ENTRY1_PROLOG_8B", PROLOG_BYTES)' in source_text
                            and "PROLOG_BYTES = 8" in source_text,
        "IMAGE_LABELS_EXE_ENTRY1": 'window_rows("EXE"' in source_text and 'window_rows("ENTRY1"' in source_text,
        "B54DC_BREAKPOINT_WINDOW_REMOVED": "BREAKPOINT_TARGET" not in source_text,
    }
    sa1_dirs = sorted(
        (root / "reports" / "stage1_economy").glob("sa1-run-*/attempt-1"),
        key=lambda p: int(re.search(r"sa1-run-(\d+)", str(p)).group(1))
    )
    status_ok = bool(sa1_dirs)
    instruction_ok = True
    instruction_count = 0
    for directory in sa1_dirs:
        summary_path = directory / "SA1_SUMMARY.txt"
        action_path = directory / "ACTIONS_RUN_SUMMARY.txt"
        try:
            summary_status = next(
                line.split("=", 1)[1] for line in summary_path.read_text(encoding="utf-8").splitlines()
                if line.startswith("STATUS=")
            )
            action_status = next(
                line.split("=", 1)[1] for line in action_path.read_text(encoding="utf-8").splitlines()
                if line.startswith("STATUS=")
            )
            status_ok = status_ok and summary_status == action_status
        except Exception:
            status_ok = False

        instruction_path = directory / "SA1_INSTRUCTIONS.tsv"
        if not instruction_path.exists():
            continue
        instruction_count += 1
        try:
            with instruction_path.open("r", encoding="utf-8-sig", newline="") as handle:
                reader = csv.DictReader(handle, delimiter="\t")
                header_map = {normalize_header(name): name for name in (reader.fieldnames or [])}
                if not {"image", "pc"}.issubset(header_map):
                    instruction_ok = False
                    continue
                instruction_rows = list(reader)
            labels_by_pc = []
            for row in instruction_rows:
                pc = parse_pc(row[header_map["pc"]])
                label = normalize_image(row[header_map["image"]])
                labels_by_pc.append((label, pc))
            exe_pcs = sorted(pc for label, pc in labels_by_pc if label == "EXE")
            entry_pcs = sorted(pc for label, pc in labels_by_pc if label == "ENTRY1")
            expected_exe = list(range(0x80011A28, 0x80011A68, 4))
            expected_entry = [0x800B50AC, 0x800B50B0]
            target_window = [
                pc for _, pc in labels_by_pc
                if 0x800B54D8 <= pc < 0x800B5518
            ]
            instruction_ok = instruction_ok and (
                len(instruction_rows) == 18
                and exe_pcs == expected_exe
                and entry_pcs == expected_entry
                and not target_window
                and all(label in {"EXE", "ENTRY1"} for label, _ in labels_by_pc)
            )
            summary_text = summary_path.read_text(encoding="utf-8")
            summary_fields = {
                line.split("=", 1)[0]: line.split("=", 1)[1]
                for line in summary_text.splitlines() if "=" in line
            }
            instruction_ok = instruction_ok and (
                summary_fields.get("WINDOWS_BYTES") == "CALLER_64_PROLOG_8"
                and summary_fields.get("WINDOWS")
                    == "EXE_CALLER_1A28_64B;ENTRY1_PROLOG_CANDIDATE_8B"
            )
        except Exception:
            instruction_ok = False
    checks["ALL_SA1_STATUS_MATCHES_ACTIONS_REPORTS"] = status_ok
    checks["ALL_SA1_INSTRUCTION_WINDOWS_COMPACT_AND_NORMALIZED"] = (
        instruction_count >= 1 and instruction_ok
    )
    checks["LATEST_SA1_STATUS_MATCHES_ACTIONS_REPORT"] = status_ok
    return checks


TRIM_RANGES = (
    ("ENTRY1", 0x800D77C4, 0x800D77C8),
    ("ENTRY1", 0x800D7D4C, 0x800D7D50),
    ("ENTRY1", 0x800F5DCC, 0x800F5DD0),
    ("EXE", 0x80011A1C, 0x80011A28),
)
PROTECTED_RANGES = (
    ("EXE", 0x80011A28, 0x80011A68),
    ("ENTRY1", 0x800B50AC, 0x800B50B4),
)


def prune_target_rows(stage: Path, root: Path, out: Path):
    removed = []
    changed_paths = []
    eligible_files = 0
    guard_failures = []
    for path in sorted(stage.rglob("*.tsv")):
        original = path.read_bytes()
        has_bom = original.startswith(b"\xef\xbb\xbf")
        try:
            text = original.decode("utf-8-sig")
            physical_lines = text.splitlines(keepends=True)
            reader = csv.reader(io.StringIO(text, newline=""), delimiter="\t")
            header = next(reader)
        except (UnicodeDecodeError, csv.Error, StopIteration):
            continue
        header_end = reader.line_num
        header_map = {normalize_header(name): index for index, name in enumerate(header)}
        if not {"image", "pc", "bytes"}.issubset(header_map):
            continue
        eligible_files += 1
        kept_lines = physical_lines[:header_end]
        cursor = header_end
        file_removed = 0
        for cells in reader:
            end_line = reader.line_num
            record_lines = physical_lines[cursor:end_line]
            cursor = end_line
            if not cells or len(cells) <= max(header_map["image"], header_map["pc"], header_map["bytes"]):
                kept_lines.extend(record_lines)
                continue
            try:
                image = normalize_image(cells[header_map["image"]])
                pc = parse_pc(cells[header_map["pc"]])
                payload = parse_bytes(cells[header_map["bytes"]])
            except Exception:
                kept_lines.extend(record_lines)
                continue
            if not payload:
                kept_lines.extend(record_lines)
                continue
            overlaps = [
                (label, start, end)
                for label, start, end in TRIM_RANGES
                if image == label and pc < end and pc + len(payload) > start
            ]
            if not overlaps:
                kept_lines.extend(record_lines)
                continue
            protected = [
                (label, start, end)
                for label, start, end in PROTECTED_RANGES
                if image == label and pc < end and pc + len(payload) > start
            ]
            if protected:
                guard_failures.append([
                    path.relative_to(root).as_posix(), end_line,
                    image, f"0x{pc:08X}", len(payload),
                    ";".join(f"{label}:0x{start:08X}-0x{end-1:08X}"
                             for label, start, end in protected),
                ])
                kept_lines.extend(record_lines)
                continue
            overlap_names = ";".join(
                f"{label}:0x{start:08X}-0x{end-1:08X}"
                for label, start, end in overlaps
            )
            removed.append([
                path.relative_to(root).as_posix(), end_line, image,
                f"0x{pc:08X}", len(payload), overlap_names,
            ])
            file_removed += 1
        if cursor < len(physical_lines):
            kept_lines.extend(physical_lines[cursor:])
        if file_removed:
            rewritten = "".join(kept_lines).encode("utf-8")
            if has_bom:
                rewritten = b"\xef\xbb\xbf" + rewritten
            path.write_bytes(rewritten)
            changed_paths.append(path.relative_to(root).as_posix())
    if changed_paths:
        git(root, "add", "--", *changed_paths)
    write_tsv(
        out / "QA0_TRIM_REMOVALS.tsv",
        ["source_file", "source_line_end", "image", "pc", "byte_count", "trim_range"],
        removed,
    )
    write_tsv(
        out / "QA0_TRIM_PROTECTED_WINDOW_GUARDS.tsv",
        ["source_file", "source_line_end", "image", "pc", "byte_count", "protected_range"],
        guard_failures,
    )
    return removed, changed_paths, eligible_files, not guard_failures


def literal_repr_audit(root: Path, out: Path):
    source_path = root / "tools" / "qa" / "RunQA0Harness.pytxt"
    tree = ast.parse(source_path.read_text(encoding="utf-8"), filename=str(source_path))
    rows = []
    ok = True
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        fn = node.func
        fn_name = fn.attr if isinstance(fn, ast.Attribute) else (fn.id if isinstance(fn, ast.Name) else "")
        for keyword in node.keywords:
            if keyword.arg != "delimiter":
                continue
            try:
                value = ast.literal_eval(keyword.value)
            except Exception:
                value = None
            passed = value == "\t"
            rows.append(["DELIMITER", node.lineno, repr(value), "PASS" if passed else "FAIL_EXPECTED_SINGLE_TAB"])
            ok = ok and passed
        if isinstance(fn, ast.Attribute) and isinstance(fn.value, ast.Name) and fn.value.id == "re":
            if fn_name in {"sub", "search", "match", "fullmatch", "compile"} and node.args:
                try:
                    pattern = ast.literal_eval(node.args[0])
                except Exception:
                    continue
                passed = isinstance(pattern, str) and "\\\\" not in pattern
                rows.append(["REGEX", node.lineno, repr(pattern), "PASS" if passed else "FAIL_DOUBLE_BACKSLASH"])
                ok = ok and passed
    write_tsv(out / "QA0_LITERAL_REPR.tsv", ["kind", "line", "repr_value", "status"], rows)
    return ok, rows


def independent_union_check(stage: Path, out: Path):
    independent_script = r'''
import csv, json, re, sys
from collections import defaultdict
from pathlib import Path

stage = Path(sys.argv[1])
values = {}
conflicts = set()
valid_rows = 0
eligible_files = 0
labels = set()
blocked_rows = 0
blocked = (
    ("ENTRY1", 0x800D77C4, 0x800D77C8),
    ("ENTRY1", 0x800D7D4C, 0x800D7D50),
    ("ENTRY1", 0x800F5DCC, 0x800F5DD0),
    ("EXE", 0x80011A1C, 0x80011A28),
)
for path in sorted(stage.rglob("*.tsv")):
    try:
        with path.open("r", encoding="utf-8-sig", newline="") as stream:
            reader = csv.DictReader(stream, delimiter="\t")
            headers = {str(name).strip().lower(): name for name in (reader.fieldnames or [])}
            if not {"image", "pc", "bytes"}.issubset(headers):
                continue
            eligible_files += 1
            for row in reader:
                raw = (row.get(headers["image"]) or "").strip().upper()
                compact = re.sub(r"[^A-Z0-9]", "", raw)
                if "ENTRY1" in compact:
                    image = "ENTRY1"
                elif compact in {"EXE", "SLPS03553", "SLPS03553EXE"} or "SLPS03553" in compact:
                    image = "EXE"
                else:
                    image = re.sub(r"[^A-Z0-9]+", "_", raw).strip("_") or "TIDAK_TAHU"
                pc_text = (row.get(headers["pc"]) or "").strip()
                byte_text = (row.get(headers["bytes"]) or "").strip()
                if not pc_text or not byte_text or image == "TIDAK_TAHU":
                    continue
                tokens = byte_text.split()
                if not tokens or any(len(token) != 2 for token in tokens):
                    continue
                try:
                    pc = int(pc_text, 16)
                    payload = bytes(int(token, 16) for token in tokens)
                except Exception:
                    continue
                valid_rows += 1
                labels.add(image)
                if any(image == label and pc < end and pc + len(payload) > start
                       for label, start, end in blocked):
                    blocked_rows += 1
                for index, byte in enumerate(payload):
                    key = (image, pc + index)
                    old = values.get(key)
                    if old is not None and old != byte:
                        conflicts.add(key)
                    else:
                        values[key] = byte
    except Exception:
        continue
by_image = defaultdict(list)
for image, address in values:
    by_image[image].append(address)
spans = []
for image, addresses in by_image.items():
    addresses.sort()
    if not addresses:
        continue
    start = previous = addresses[0]
    for address in addresses[1:]:
        if address != previous + 1:
            spans.append((image, start, previous + 1))
            start = address
        previous = address
    spans.append((image, start, previous + 1))
over = [
    {"image": image, "start": f"0x{start:08X}", "end_exclusive": f"0x{end:08X}",
     "bytes": end - start}
    for image, start, end in spans if end - start > 64
]
print(json.dumps({
    "eligible_files": eligible_files,
    "valid_rows": valid_rows,
    "unique_addresses": len(values),
    "labels": sorted(labels),
    "max_span": max((end - start for _, start, end in spans), default=0),
    "over_64_groups": over,
    "over_64_count": len(over),
    "conflict_count": len(conflicts),
    "blocked_rows": blocked_rows,
}, sort_keys=True))
'''
    result = subprocess.run(
        [sys.executable, "-c", independent_script, str(stage)],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0:
        summary = {"status": "FAIL", "reason": "independent_process_exit",
                   "exit_code": result.returncode, "stderr": result.stderr[-1000:]}
        ok = False
    else:
        try:
            summary = json.loads(result.stdout.strip().splitlines()[-1])
            ok = (
                summary.get("over_64_count") == 0
                and summary.get("conflict_count") == 0
                and summary.get("blocked_rows") == 0
            )
            summary["status"] = "PASS" if ok else "FAIL"
        except Exception as exc:
            summary = {"status": "FAIL", "reason": "independent_output_parse",
                       "detail": type(exc).__name__ + ":" + str(exc)}
            ok = False
    (out / "QA0_INDEPENDENT_UNION_SUMMARY.txt").write_text(
        "\n".join(f"{key}={json.dumps(value, sort_keys=True) if isinstance(value, (dict, list)) else value}"
                  for key, value in summary.items()) + "\n",
        encoding="utf-8",
    )
    return summary, ok



def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    parser.add_argument("--baseline", default=BASELINE_DEFAULT)
    args = parser.parse_args()
    root = args.root.resolve()
    out = args.out.resolve()
    out.mkdir(parents=True, exist_ok=True)
    stage = root / "reports" / "stage1_economy"

    compiled = []
    tracked = git(root, "ls-files", "-z").split("\0")
    compile_paths = [root / path for path in tracked
                     if path.endswith((".py", ".pytxt")) and (root / path).is_file()]
    for path in sorted(compile_paths):
        try:
            compile(path.read_text(encoding="utf-8"), str(path), "exec")
            compiled.append([path.relative_to(root).as_posix(), "PASS", ""])
        except Exception as exc:
            compiled.append([path.relative_to(root).as_posix(), "FAIL",
                             type(exc).__name__ + ":" + str(exc)])
    write_tsv(out / "QA0_PYCOMPILE.tsv", ["path", "status", "reason"], compiled)

    deletion_rows, deletion_statuses = audit_target_deletions(root, args.baseline)
    write_tsv(out / "QA0_TARGET_DIRECTORY_DELETIONS.tsv",
              ["directory", "baseline_files", "deleted_files", "head_files_remaining", "verification"],
              deletion_rows)

    trim_rows, trim_files, trim_eligible_files, trim_ok = prune_target_rows(stage, root, out)
    literal_ok, literal_rows = literal_repr_audit(root, out)

    rows, total_tsv, evidence_files, malformed, labels = read_evidence(stage)
    values, origins, conflicts, spans = byte_union(rows)
    ha2_audit, ha2_ok, ha2_performed = maybe_prune_ha2(stage, root, args.baseline, spans)
    if ha2_performed:
        rows, total_tsv, evidence_files, malformed, labels = read_evidence(stage)
        values, origins, conflicts, spans = byte_union(rows)
    independent_summary, independent_ok = independent_union_check(stage, out)
    write_tsv(out / "QA0_HA2_CONDITIONAL_REMOVAL.tsv",
              ["source_file", "baseline_rows", "head_rows", "deleted_rows", "pc", "bytes",
               "image", "git_status", "verification"],
              ha2_audit)

    over = [(image, start, end, end - start) for image, start, end in spans
            if end - start > LIMIT]
    write_tsv(out / "QA0_FULL_ARCHIVE_SPANS.tsv",
              ["image", "start_pc", "end_pc_exclusive", "contiguous_bytes"],
              [[image, f"0x{start:08X}", f"0x{end:08X}", end - start]
               for image, start, end in spans])
    write_tsv(out / "QA0_FULL_ARCHIVE_OVERLIMIT.tsv",
              ["image", "start_pc", "end_pc_exclusive", "contiguous_bytes"],
              [[image, f"0x{start:08X}", f"0x{end:08X}", size]
               for image, start, end, size in over])
    over_origin_rows = []
    for image, start, end, size in over:
        group_origins = set()
        for address in range(start, end):
            for source_file, source_line, row_pc, row_bytes in origins.get((image, address), []):
                group_origins.add((source_file, source_line, row_pc, row_bytes))
        for source_file, source_line, row_pc, row_bytes in sorted(group_origins):
            over_origin_rows.append([
                image, f"0x{start:08X}", f"0x{end:08X}", size,
                source_file, source_line, f"0x{row_pc:08X}", row_bytes,
            ])
    write_tsv(
        out / "QA0_OVERLIMIT_ORIGINS.tsv",
        ["image", "group_start_pc", "group_end_pc_exclusive", "group_bytes",
         "source_file", "source_line", "row_pc", "row_bytes"],
        over_origin_rows,
    )
    conflict_rows = [[image, f"0x{address:08X}",
                      ";".join(f"{source}:{line}" for source, line, _, _ in origins[(image, address)])]
                     for image, address in sorted(conflicts)]
    write_tsv(out / "QA0_BYTE_OVERLAP_CONFLICTS.tsv", ["image", "address", "origins"], conflict_rows)
    write_tsv(out / "QA0_MALFORMED_BYTE_ROWS.tsv",
              ["source_file", "source_line", "image", "pc", "bytes", "reason"], malformed)

    workflow = workflow_path_audit(root)
    workflow_checks = {
        "NO_CATCHALL_PY_FILTERS": not workflow["catchalls"],
        "NO_LEGACY_SA1_WORKFLOW_REFS": not workflow["legacy_refs"],
        "PREPARATION_COMMIT_HAS_SKIP_CI": workflow["prep_commit_skip_ci"],
        "LAST_COMMIT_ONLY_QA0_TRIGGER": workflow["last_commit_files"] == ["tools/qa/RunQA0Harness.pytxt"]
                                         and workflow["trigger_matches"] == ["qa0-qa5.yml"],
    }
    sa1_checks = sa1_audit(root)

    all_deletions_ok = all(deletion_statuses.values()) and sum(row[1] for row in deletion_rows) == 152
    all_ok = (
        all_deletions_ok
        and ha2_ok
        and trim_ok
        and literal_ok
        and independent_ok
        and not over
        and not conflicts
        and not malformed
        and all(row[1] == "PASS" for row in compiled)
        and all(workflow_checks.values())
        and all(sa1_checks.values())
    )
    status = "TUNTAS" if all_ok else "BELUM"
    summary = [
        f"BASELINE_INCLUSIVE={args.baseline}",
        f"STATUS={status}",
        "CONFIDENCE=K4",
        f"TARGET_DIRECTORIES={len(TARGET_DIRS)}",
        f"TARGET_FILES_AT_BASELINE={sum(row[1] for row in deletion_rows)}",
        f"TARGET_FILES_DELETED={sum(row[2] for row in deletion_rows)}",
        f"TARGET_FILES_REMAINING={sum(row[3] for row in deletion_rows)}",
        f"ALL_STAGE1_TSV_FILES_SCANNED={total_tsv}",
        f"TSV_WITH_IMAGE_PC_BYTES_HEADERS={len(evidence_files)}",
        f"VALID_BYTE_ROWS={len(rows)}",
        f"UNIQUE_BYTE_ADDRESSES={len(values)}",
        f"IMAGE_LABELS_NORMALIZED={';'.join(labels)}",
        f"UNION_MAX_CONTIGUOUS_BYTES={max((end-start for _, start, end in spans), default=0)}",
        f"UNION_OVER_64_BYTE_GROUPS={len(over)}",
        f"OVERLIMIT_ORIGIN_ROWS={len(over_origin_rows)}",
        f"BYTE_OVERLAP_CONFLICT_ADDRESSES={len(conflicts)}",
        f"MALFORMED_BYTE_ROWS={len(malformed)}",
        f"HA2_CONDITIONAL_REMOVAL_PERFORMED={'YES' if ha2_performed else 'NO'}",
        f"HA2_CONDITIONAL_REMOVAL_STATUS={'PASS' if ha2_ok else 'FAIL'}",
        f"TRIMMED_OVERLAP_ROWS={len(trim_rows)}",
        f"TRIMMED_TSV_FILES={len(trim_files)}",
        f"TRIM_ELIGIBLE_TSV_FILES={trim_eligible_files}",
        f"TRIM_STATUS={'PASS' if trim_ok else 'FAIL'}",
        f"LITERAL_REPR_STATUS={'PASS' if literal_ok else 'FAIL'}",
        f"LITERAL_REPR_CHECKS={len(literal_rows)}",
        f"INDEPENDENT_UNION_STATUS={independent_summary.get('status', 'FAIL')}",
        f"INDEPENDENT_UNION_MAX_CONTIGUOUS_BYTES={independent_summary.get('max_span', 'TIDAK_TAHU')}",
        f"INDEPENDENT_UNION_OVER_64_GROUPS={independent_summary.get('over_64_count', 'TIDAK_TAHU')}",
        f"INDEPENDENT_BLOCKED_ROWS={independent_summary.get('blocked_rows', 'TIDAK_TAHU')}",
        f"WORKFLOW_FILES={workflow['workflow_count']}",
        f"PATH_FILTER_PATTERNS={workflow['path_pattern_count']}",
        f"CATCHALL_PY_FILTERS={';'.join(workflow['catchalls']) or 'NONE'}",
        f"LEGACY_SA1_WORKFLOW_REFERENCES={';'.join(workflow['legacy_refs']) or 'NONE'}",
        f"PREPARATION_COMMIT_SKIP_CI={'YES' if workflow['prep_commit_skip_ci'] else 'NO'}",
        f"LAST_COMMIT_FILES={';'.join(workflow['last_commit_files'])}",
        f"TRIGGER_MATCH_WORKFLOWS={';'.join(workflow['trigger_matches'])}",
        f"PY_COMPILE={sum(row[1]=='PASS' for row in compiled)}/{len(compiled)}",
        "EMULATOR_RUNS=0",
        "BINARY_OUTPUT=NONE",
        "STATUS_MD_MODIFIED=NO",
        "RELEASES_MODIFIED=NO",
    ]
    for key, passed in workflow_checks.items():
        summary.append(f"WORKFLOW_CHECK_{key}={'PASS' if passed else 'FAIL'}")
    for key, passed in sa1_checks.items():
        summary.append(f"SA1_CHECK_{key}={'PASS' if passed else 'FAIL'}")
    (out / "QA0_EXCERPT_AUDIT.txt").write_text("\n".join(summary) + "\n", encoding="utf-8")
    print("\n".join(summary))
    if not all_ok:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
